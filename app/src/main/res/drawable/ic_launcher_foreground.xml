<!-- A clapperboard (cinema) with a play button on it (watch online). Kept inside the adaptive icon's
     safe zone (the middle 66 of 108), so no launcher mask cuts it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <group android:pivotX="54" android:pivotY="54" android:scaleX="1.08" android:scaleY="1.08" android:translateY="-3">

    <!-- soft shadow under the board -->
    <path android:fillColor="#40000000"
        android:pathData="M31,51h48a5,5 0,0 1,5 5v22a5,5 0,0 1,-5 5h-48a5,5 0,0 1,-5 -5v-22a5,5 0,0 1,5 -5z" />

    <!-- the board -->
    <path android:pathData="M30,48h48a5,5 0,0 1,5 5v23a5,5 0,0 1,-5 5h-48a5,5 0,0 1,-5 -5v-23a5,5 0,0 1,5 -5z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="54" android:startY="48" android:endX="54" android:endY="81"
                android:startColor="#FF26324A" android:endColor="#FF121A2A" />
        </aapt:attr>
    </path>

    <!-- the striped band on the board -->
    <group>
        <clip-path android:pathData="M25,48h58v8h-58z" />
        <path android:fillColor="#FFF4F6FA" android:pathData="M25,48h58v8h-58z" />
        <path android:fillColor="#FFFF5E57"
            android:pathData="M27,56l6,-8h8l-6,8zM43,56l6,-8h8l-6,8zM59,56l6,-8h8l-6,8zM75,56l6,-8h8l-6,8zM11,56l6,-8h8l-6,8z" />
    </group>

    <!-- the clapper stick, lifted on its hinge -->
    <group android:pivotX="27" android:pivotY="46" android:rotation="-15">
        <clip-path android:pathData="M27,37h56v8h-56z" />
        <path android:fillColor="#FFF4F6FA" android:pathData="M27,37h56v8h-56z" />
        <path android:fillColor="#FFFF5E57"
            android:pathData="M29,45l6,-8h8l-6,8zM45,45l6,-8h8l-6,8zM61,45l6,-8h8l-6,8zM77,45l6,-8h8l-6,8zM13,45l6,-8h8l-6,8z" />
