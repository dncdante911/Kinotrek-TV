    <!-- the hinge -->
    <path android:fillColor="#FF0A0E16" android:pathData="M27,46m-2.6,0a2.6,2.6 0,1 1,5.2 0a2.6,2.6 0,1 1,-5.2 0" />

    <!-- the play button -->
    <path android:fillColor="#FF5EE0D2" android:pathData="M54,68.5m-9.5,0a9.5,9.5 0,1 1,19 0a9.5,9.5 0,1 1,-19 0" />
    <path android:fillColor="#FF0A0E16" android:pathData="M51,63.5L51,73.5L59.5,68.5Z" />
