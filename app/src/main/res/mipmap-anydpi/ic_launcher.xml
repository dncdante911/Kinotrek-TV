<!-- Android 7: no adaptive icons yet (see mipmap-anydpi-v26), so the same layers stacked into a plain
     square. A TV launcher shows the banner anyway; this is for the app list and settings. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
