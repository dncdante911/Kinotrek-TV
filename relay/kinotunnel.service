[Unit]
Description=Kinotrek tunnel (VLESS + Reality into the relay, for viewers whose provider blocks it)
After=network-online.target kinorelay.service
Wants=network-online.target

[Service]
User=kinotunnel
Group=kinotunnel
ExecStart=/opt/kinotunnel/xray run -config /etc/kinotunnel/config.json
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=256M
TasksMax=512

[Install]
WantedBy=multi-user.target
